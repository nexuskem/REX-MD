# =============================================
# REX-MD — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================

# --- WhatsApp ---
SESSION_ID=REX-MD
# Your WhatsApp number in international format WITHOUT the + sign
# Kenya example: 2547XXXXXXXX
OWNER_NUMBER=2547XXXXXXXX
# Set to true to use pairing code instead of QR scan (recommended)
USE_PAIRING_CODE=true
# Command prefix (can be changed at runtime via .setprefix)
PREFIX=.
BOT_NAME=REX-MD

# --- MongoDB ---
# Your MongoDB Atlas connection string, or a local MongoDB URI
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/rexmd

# --- AI: Gemini (primary) ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-2.5-flash

# --- AI: Groq (fallback) ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Downloads ---
# Maximum file size in MB to send over WhatsApp (WhatsApp limit is 100MB but keep it lower)
MAX_DOWNLOAD_MB=50

# --- Status ---
# Automatically read/view contacts' WhatsApp statuses
AUTO_STATUS_VIEW=true
# Leave an emoji reaction on viewed statuses
AUTO_STATUS_REACT=false
# Emoji to use for status reactions
STATUS_REACT_EMOJI=👀

# --- Anti-spam ---
# Cooldown in milliseconds between commands per user
COMMAND_COOLDOWN_MS=2000

# --- Weather API (for .weather command) ---
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Anti-delete ---
# Forward deleted messages to owner DM
ANTI_DELETE=false

# --- Log level ---
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
